FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy project files for restoring
COPY ["src/BuildingBlocks/MangaERP.BuildingBlocks.Domain/MangaERP.BuildingBlocks.Domain.csproj", "BuildingBlocks/MangaERP.BuildingBlocks.Domain/"]
COPY ["src/BuildingBlocks/MangaERP.BuildingBlocks.Application/MangaERP.BuildingBlocks.Application.csproj", "BuildingBlocks/MangaERP.BuildingBlocks.Application/"]
COPY ["src/BuildingBlocks/MangaERP.BuildingBlocks.Infrastructure/MangaERP.BuildingBlocks.Infrastructure.csproj", "BuildingBlocks/MangaERP.BuildingBlocks.Infrastructure/"]
COPY ["src/BuildingBlocks/MangaERP.BuildingBlocks.Contracts/MangaERP.BuildingBlocks.Contracts.csproj", "BuildingBlocks/MangaERP.BuildingBlocks.Contracts/"]
COPY ["src/Services/Submission/MangaERP.Submission/MangaERP.Submission.csproj", "Services/Submission/MangaERP.Submission/"]

RUN dotnet restore "Services/Submission/MangaERP.Submission/MangaERP.Submission.csproj"

# Copy the remaining source files and build
COPY src/ /src/
WORKDIR "/src/Services/Submission/MangaERP.Submission"
RUN dotnet publish "MangaERP.Submission.csproj" -c Release -o /app/publish /p:UseAppHost=false -m:1 /p:UseSharedCompilation=false

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "MangaERP.Submission.dll"]
