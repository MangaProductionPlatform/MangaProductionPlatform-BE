		{
			"name": "1. Happy Path Flow",
			"item": [
				{
					"name": "1.1 Submit Proposal (Reader)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.submissionId) {",
									"    pm.collectionVariables.set(\"submissionId\", jsonData.submissionId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{readerToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"submitterId\": \"{{submitterId}}\",\n  \"title\": \"Hành Trình Kỳ Thú\",\n  \"description\": \"Câu chuyện phiêu lưu của cậu bé Tèo tại thế giới song song.\",\n  \"genre\": \"Adventure, Fantasy\",\n  \"coverImageUrl\": \"https://example.com/images/cover.jpg\",\n  \"manuscriptUrl\": \"https://example.com/files/manuscript.pdf\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/submissions",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"submissions"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Recommend Proposal (Tantou Editor)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{editorToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reviewerEditorId\": \"{{editorId}}\",\n  \"feedbackMessage\": \"Cốt truyện hấp dẫn, tạo hình nhân vật tốt. Đề xuất duyệt bản thảo này.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/submissions/{{submissionId}}/recommend",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"submissions",
								"{{submissionId}}",
								"recommend"
							]
						}
					},
					"response": []
				},
				{
					"name": "1.3 Approve Proposal (Editorial Board)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{boardToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/submissions/{{submissionId}}/approve?reviewerId={{boardMemberId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"submissions",
								"{{submissionId}}",
								"approve"
							],
							"query": [
								{
									"key": "reviewerId",
									"value": "{{boardMemberId}}"
								}
							]
						}
					},
					"response": []
				}
			]
		},
